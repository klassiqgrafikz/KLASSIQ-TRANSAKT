generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MERCHANT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  KYC_REQUIRED
}

enum KycLevel {
  NONE
  BASIC
  FULL
}

enum TxnType {
  DEPOSIT
  SELL
  WITHDRAW
  PAYMENT_LINK
}

enum TxnStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  MANUAL_REVIEW
}

enum LinkStatus {
  ACTIVE
  EXPIRED
  DISABLED
  COMPLETED
}

enum Direction {
  ABOVE
  BELOW
}

enum ExchangeProvider {
  YELLOW_CARD
  QUIDAX
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  avatar        String?
  role          Role      @default(USER)
  status        UserStatus @default(PENDING)
  kycLevel      KycLevel  @default(NONE)
  inviteCode    String?   @unique
  invitedBy     String?
  passwordHash  String?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      BankAccount[]
  transactions  Transaction[]
  apiKeys       ApiKey[]
  paymentLinks  PaymentLink[]
  rateAlerts    RateAlert[]
  sessions      Session[]
  invites       Invite[]    @relation("InviteCreator")
  receivedInvite Invite?    @relation("InviteRecipient")
  auditLogs     AuditLog[]
  cashDeposits  CashDepositIntent[]

  @@index([email])
  @@index([inviteCode])
  @@index([status])
  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  email     String    @unique
  role      Role      @default(USER)
  usedBy    String?   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  createdBy String

  creator   User     @relation("InviteCreator", fields: [createdBy], references: [id])
  recipient User?    @relation("InviteRecipient", fields: [usedBy], references: [id])

  @@index([email])
  @@index([code])
  @@index([expiresAt])
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  isDefault     Boolean  @default(false)
  isVerified    Boolean  @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, accountNumber, bankCode])
  @@index([userId])
  @@index([bankCode])
}

model Bank {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([slug])
}

model Transaction {
  id                    String           @id @default(cuid())
  userId                String
  type                  TxnType
  status                TxnStatus        @default(PENDING)
  provider              ExchangeProvider @default(YELLOW_CARD)

  btcAmount             Decimal?         @db.Decimal(18, 8)
  btcTxHash             String?
  btcAddress            String?
  network               String?          // BITCOIN, LIGHTNING

  ngnAmount             Decimal?         @db.Decimal(18, 2)
  exchangeRate          Decimal?         @db.Decimal(18, 2)
  fees                  Decimal          @default(0) @db.Decimal(18, 2)
  platformFee           Decimal          @default(0) @db.Decimal(18, 2)

  exchangeOrderId       String?
  exchangeWithdrawalId  String?
  exchangeDepositId     String?
  paymentLinkId         String?

  bankAccountId         String?
  bankAccount           BankAccount?     @relation(fields: [bankAccountId], references: [id])

  metadata              Json?
  errorMessage          String?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentLink           PaymentLink?     @relation(fields: [paymentLinkId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@index([type])
  @@index([exchangeOrderId])
  @@index([paymentLinkId])
}

model PaymentLink {
  id            String      @id @default(cuid())
  userId        String
  slug          String      @unique
  title         String
  description   String?
  btcAmount     Decimal?    @db.Decimal(18, 8)
  ngnAmount     Decimal?    @db.Decimal(18, 2)
  status        LinkStatus  @default(ACTIVE)
  expiresAt     DateTime?
  maxUses       Int?
  currentUses   Int         @default(0)
  redirectUrl   String?
  webhookUrl    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([userId])
  @@index([slug])
  @@index([status])
}

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  keyHash     String
  prefix      String
  permissions String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prefix])
}

model RateAlert {
  id          String      @id @default(cuid())
  userId      String
  targetRate  Decimal     @db.Decimal(18, 2)
  direction   Direction
  enabled     Boolean     @default(true)
  notifiedAt  DateTime?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled, targetRate])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
}

model ExchangeRateCache {
  id        String   @id @default(cuid())
  provider  ExchangeProvider
  fromCurrency String
  toCurrency String
  rate      Decimal  @db.Decimal(18, 8)
  source    String   // API, calculated
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([provider, fromCurrency, toCurrency])
  @@index([expiresAt])
}

model CashDepositIntent {
  id             String   @id @default(cuid())
  userId         String
  merchantRef    String   @unique
  publicId       String?
  toCurrency     String   // usdt | btc | usdc ...
  network        String
  destAddress    String
  amountNgn      Decimal  @db.Decimal(18, 2)
  amountExpected Decimal? @db.Decimal(18, 2)
  acctNumber     String?
  acctBankName   String?
  acctName       String?
  processorFee   Decimal? @db.Decimal(18, 2)
  status         String   @default("initiated") // initiated | awaiting_payment | processing | completed | failed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model PlatformSettings {
  id                    String   @id @default("singleton")
  platformFeeBps        Int      @default(50) // 0.5%
  minTradeNgn           Decimal  @default(1000) @db.Decimal(18, 2)
  maxTradeNgnDailyBasic Decimal  @default(500000) @db.Decimal(18, 2)
  maxTradeNgnDailyFull  Decimal  @default(10000000) @db.Decimal(18, 2)
  maintenanceMode       Boolean  @default(false)
  enableKyc             Boolean  @default(true)
  enablePaymentLinks    Boolean  @default(true)
  enableApiKeys         Boolean  @default(true)
  enableRateAlerts      Boolean  @default(true)
  defaultExchangeProvider ExchangeProvider @default(YELLOW_CARD)
  updatedAt             DateTime @updatedAt
}