# ===========================================
# KLASSIQ TRANSAKT - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# ===========================================

# -------------------------------------------
# DATABASE (PostgreSQL - Supabase/Neon/PlanetScale)
# -------------------------------------------
DATABASE_URL="postgresql://postgres.vohotiaovkocnwuyfszo:mysupabaseprojectwork2026@aws-1-eu-west-1.pooler.supabase.com:6543/postgres"
# For Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# For Neon: postgresql://[user]:[password]@[endpoint]/[dbname]?sslmode=require

# -------------------------------------------
# AUTH (NextAuth.js)
# -------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend) - for magic links and notifications
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_your_resend_api_key"
EMAIL_FROM="KLASSIQ TRANSAKT <noreply@yourdomain.com>"

# -------------------------------------------
# YELLOW CARD (Primary Exchange - RECOMMENDED)
# -------------------------------------------
# Get from: https://dashboard.yellowcard.io/developers
YELLOWCARD_API_KEY="yc_live_your_api_key"
YELLOWCARD_API_SECRET="yc_your_api_secret"
YELLOWCARD_WEBHOOK_SECRET="yc_your_webhook_secret"
YELLOWCARD_BASE_URL="https://api.yellowcard.io"  # Use sandbox for testing: https://sandbox.yellowcard.io

# -------------------------------------------
# QUIDAX (Fallback Exchange)
# -------------------------------------------
# Get from: https://www.quidax.com/developers
QUIDAX_API_KEY="your_quidax_api_key"
QUIDAX_WEBHOOK_SECRET="your_quidax_webhook_secret"
QUIDAX_BASE_URL="https://openapi.quidax.io/exchange-open-api/api/v1"

# -------------------------------------------
# RESEND (Transactional Emails)
# -------------------------------------------
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"

# -------------------------------------------
# PLATFORM CONFIGURATION
# -------------------------------------------
PLATFORM_FEE_BPS="50"                    # 0.5% platform fee (in basis points)
MIN_TRADE_NGN="1000"                     # Minimum trade amount in NGN
MAX_TRADE_NGN_DAILY_BASIC="500000"       # Daily limit for BASIC KYC (₦500K)
MAX_TRADE_NGN_DAILY_FULL="10000000"      # Daily limit for FULL KYC (₦10M)

# -------------------------------------------
# MONITORING (Optional)
# -------------------------------------------
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"

# -------------------------------------------
# FEATURE FLAGS
# -------------------------------------------
ENABLE_KYC="true"
ENABLE_PAYMENT_LINKS="true"
ENABLE_API_KEYS="true"
ENABLE_RATE_ALERTS="true"
MAINTENANCE_MODE="false"

# -------------------------------------------
# DEFAULT EXCHANGE PROVIDER
# -------------------------------------------
# Options: YELLOW_CARD (recommended) or QUIDAX
DEFAULT_EXCHANGE_PROVIDER="YELLOW_CARD"

# -------------------------------------------
# NODE ENV
# -------------------------------------------
NODE_ENV="development"